{
  "name": "panda-zap",
  "version": "1.1.2",
  "type": "module",
  "description": "Obsidian plugin with Anki Connect integration by Team Super Panda",
  "main": "main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/teamsuperpanda/pandazap"
  },
  "homepage": "https://github.com/teamsuperpanda/pandazap",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "dev": "node esbuild.config.mjs --watch",
    "test": "vitest",
    "lint": "eslint src tests --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "keywords": [],
  "author": "Team Super Panda",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-obsidianmd": "^0.5.0",
    "jsdom": "^29.1.1",
    "obsidian": "^1.14.4",
    "prettier": "^3.9.10",
    "tslib": "^2.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.4",
    "vite": {
      ".": "8.3.6"
    },
    "js-yaml": "4.3.2",
    "flatted": "3.4.4",
    "picomatch": "4.0.7",
    "postcss": "8.5.32",
    "yaml": "2.9.1"
  }
}
